APP_NAME="AI Chatbot Hub Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com
# SESSION_SECURE_COOKIE=true when using HTTPS

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chatbot_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@aichatbothub.local"
MAIL_FROM_NAME="${APP_NAME}"

# Outbound HTTPS (crawler, OpenAI). Bundled CA: storage/certs/cacert.pem (fixes cURL 60 on Windows).
# HTTP_SSL_VERIFY=true
# HTTP_CA_BUNDLE=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
SEMANTIC_SEARCH_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_SEARCH_MIN_SCORE=0.72

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

WIDGET_CONFIG_CACHE_TTL=60
AUTH_LOCKOUT_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30
CHAT_SLA_MINUTES=15
CRAWL_MAX_PAGES=30
CRAWL_MAX_DEPTH=2

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=chatbot-hub
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
